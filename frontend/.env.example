# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT=30000

# App Configuration
NEXT_PUBLIC_APP_NAME=CMS3 POS
NEXT_PUBLIC_VERSION=0.1.0
NEXT_PUBLIC_ENVIRONMENT=development

# Feature Flags
NEXT_PUBLIC_ENABLE_OFFLINE=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Auth Configuration
NEXT_PUBLIC_JWT_STORAGE_KEY=cms3_jwt_token
NEXT_PUBLIC_REFRESH_TOKEN_KEY=cms3_refresh_token
NEXT_PUBLIC_AUTH_TIMEOUT=3600000

# Payment Configuration (Optional)
NEXT_PUBLIC_STRIPE_KEY=pk_test_xxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=xxx

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GTAG_ID=

# Database/Cache (Backend URLs)
NEXT_PUBLIC_REDIS_URL=http://localhost:6379
